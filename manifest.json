{
  "manifest_version": 3,
  "name": "skribbl word helper",
  "version": "1.3.0",
  "description": "Shows which skribbl.io words still fit the live hint, ranked using the round's own chat evidence.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://skribbl.io/*"
      ],
      "js": [
        "words.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css",
        "words-extra.json"
      ],
      "matches": [
        "https://skribbl.io/*"
      ]
    }
  ]
}
